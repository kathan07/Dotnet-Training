@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<nav class="navbar navbar-expand-lg navbar-light bg-body-tertiary shadow-sm">
    <div class="container-fluid px-5 py-3">
        <a class="navbar-brand fw-bold text-primary" style="font-size: 15px;" href="/">FinalPOC</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center" style="font-size: 14px;">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    @* USERS button - Admin only *@
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-primary fw-semibold" asp-controller="User" asp-action="Index">Users</a>
                        </li>
                    }

                    @* TASKS button - All authenticated users *@
                    <li class="nav-item">
                        <a class="nav-link text-primary fw-semibold" asp-controller="Task" asp-action="Index">Tasks</a>
                    </li>

                    @* LOGOUT button - All authenticated users *@
                    <li class="nav-item">
                        <form method="post" asp-controller="Auth" asp-action="Logout">
                            <button type="submit" class="btn btn-link nav-link text-danger fw-semibold" style="border: none; background: none; cursor: pointer;">
                                Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-primary fw-semibold" asp-controller="User" asp-action="Signin">Signin</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
