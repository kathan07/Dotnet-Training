@inject IHttpContextAccessor HttpContextAccessor
@using System.Text.Json
@using EFCore.Service.DTOModels

@{
    var userJson = HttpContextAccessor.HttpContext?.Session.GetString("User");
    var user = !string.IsNullOrEmpty(userJson) ? JsonSerializer.Deserialize<UserDTO>(userJson) : null;
    var isAdminUser = user?.Role == "Admin";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<nav class="navbar navbar-expand-lg navbar-light bg-body-tertiary shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-primary" href="/">EFCore</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center">
                @if (user != null)
                {
                    <li class="nav-item">
                        <a class="nav-link text-primary fw-semibold" asp-controller="Product" asp-action="ProductList">Products</a>
                    </li>

                    <li class="nav-item">
                        @if (isAdminUser)
                        {
                            <a class="nav-link text-primary fw-semibold" asp-controller="Order" asp-action="OrderList">Orders</a>
                        }
                        else
                        {
                            <a class="nav-link text-primary fw-semibold" asp-controller="Order" asp-action="OrderList" asp-route-id="@user.Id">Orders</a>
                        }
                    </li>

                    <li class="nav-item">
                        <form method="post" asp-controller="User" asp-action="Signout">
                            <button type="submit" class="btn btn-link nav-link text-danger fw-semibold" style="border: none; background: none; cursor: pointer;">
                                Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-primary fw-semibold" asp-controller="User" asp-action="Signin">Signin</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
