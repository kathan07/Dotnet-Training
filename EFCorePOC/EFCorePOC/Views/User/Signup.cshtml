@model EFCore.Service.DTOModels.UserDTO;
@{
    ViewData["Title"] = "Sign Up";
}

<section class="vh-100 gradient-custom">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card bg-primary text-white" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">
                        <form asp-controller="User" asp-action="Signup" method="post">

                            <span class="text-danger">@TempData["error"]</span>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-md-3 mt-md-4 pb-0">
                                <h2 class="fw-bold mb-2 text-uppercase">Sign Up</h2>
                                <p class="text-white-50 mb-5">Please fill in your details to register!</p>

                                <div class="form-outline form-white mb-3">
                                    <input asp-for="Name" id="typeFirstNameX" class="form-control form-control-lg" required/>
                                    <label asp-for="Name" class="form-label"></label>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="form-outline form-white mb-3">
                                    <input asp-for="Email" type="email" id="typeEmailX" class="form-control form-control-lg" required/>
                                    <label asp-for="Email" class="form-label"></label>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="form-outline form-white mb-3">
                                    <input asp-for="Password" type="password" id="typePasswordX" class="form-control form-control-lg" required/>
                                    <label asp-for="Password" class="form-label"></label>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <input asp-for="Role" type= "hidden" value="Customer" />

                                <button class="btn btn-outline-light btn-lg px-5" type="submit">Sign Up</button>
                            </div>

                            <div>
                                <p class="mb-0">
                                    Already have an account?
                                    <a asp-controller="User" asp-action="Signin" class="text-white-50 fw-bold">Sign In</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}